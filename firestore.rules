rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null
        && request.auth.token.parking_staff == true
        && request.time.toMillis() < request.auth.token.parking_until * 1000;
    }
    function validDriver(data) {
      return data.keys().hasAll(['plate_number', 'driver_name', 'driver_phone', 'destination', 'status'])
        && data.plate_number is string && data.plate_number.size() >= 5 && data.plate_number.size() <= 12
        && data.driver_name is string && data.driver_name.size() >= 2 && data.driver_name.size() <= 100
        && data.driver_phone is string && data.driver_phone.size() >= 9 && data.driver_phone.size() <= 16
        && data.destination is string && data.destination.size() >= 2 && data.destination.size() <= 100;
    }
    match /driver_requests/{requestId} {
      allow create: if validDriver(request.resource.data)
        && request.resource.data.keys().hasOnly(['plate_number', 'formatted_plate', 'driver_name', 'driver_phone', 'destination', 'status', 'source', 'created_at', 'server_timestamp', 'consent'])
        && request.resource.data.status == 'PENDING'
        && request.resource.data.consent == true
        && request.resource.data.server_timestamp == request.time;
      allow read: if isStaff();
      allow update: if isStaff() && validDriver(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'ticket_id', 'admitted_at', 'rejected_at', 'rejection_reason'])
        && request.resource.data.status in ['ADMITTED', 'REJECTED'];
      allow delete: if false;
    }
    match /parking_telemetry/{docId} {
      allow read: if true;
      allow write: if isStaff()
        && request.resource.data.keys().hasOnly(['capacity', 'occupied', 'available', 'today_in', 'today_out', 'updated_at'])
        && request.resource.data.capacity is int && request.resource.data.capacity > 0
        && request.resource.data.occupied is int && request.resource.data.occupied >= 0
        && request.resource.data.occupied <= request.resource.data.capacity
        && request.resource.data.available is int
        && request.resource.data.available == request.resource.data.capacity - request.resource.data.occupied;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
