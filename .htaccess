# Mombasa Mall Basement Parking - Apache Security & Routing Configuration
ServerSignature Off

# Prevent directory listings
Options -Indexes

# Set default landing file
DirectoryIndex index.php index.html

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Protect sensitive directories from direct browser access
RewriteEngine On
RewriteRule ^(config|database|includes|scripts|vendor|scratch|workers|alpr|storage/logs|storage/backups|storage/security)/ - [F,L,NC]
RewriteRule ^(\.git|\.env|composer\.(json|lock|phar)|requirements\.txt) - [F,L,NC]
RewriteRule (^|/)[^/]*\.(env|env\.local|env\.sample|sql|bak|zip)$ - [F,L,NC]
RewriteRule ^cloud/(config\.cloud(?:\.local)?\.php|schema_init\.php)$ - [F,L,NC]
RewriteRule ^storage/snapshots/(.+)$ api/guard/snapshot-image.php?file=$1 [L,NC]

# UTF-8 Encoding default
AddDefaultCharset UTF-8
