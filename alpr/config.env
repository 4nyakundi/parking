# Mombasa Mall Basement Parking - ALPR Python Worker Environment
# Edge PC Configuration (NIC 1: 192.168.0.50 on 192.168.0.0/24)

# Local PHP API Gateway
API_URL=http://127.0.0.1/parking/api/gate/plate-detected.php
HEALTH_URL=http://127.0.0.1/parking/api/health.php
API_KEY=MOMBASA_PARKING_ALPR_SECRET_KEY_2026

# CCTV Streams via Dahua NVR at 192.168.0.3 (Entrance: Ch 1, Exit: Ch 2)
# RTSP TCP on port 554: /cam/realmonitor?channel=X&subtype=0 (0=Main, 1=Sub)
ENTRANCE_RTSP=rtsp://admin:Mall@2024@192.168.0.3:554/cam/realmonitor?channel=1&subtype=0
EXIT_RTSP=rtsp://admin:Mall@2024@192.168.0.3:554/cam/realmonitor?channel=2&subtype=0

# Dahua NVR Snapshot CGI endpoints (Channel 1 = Entrance, Channel 2 = Exit)
ENTRANCE_SNAPSHOT_URL=https://192.168.0.3/cgi-bin/snapshot.cgi?channel=1
EXIT_SNAPSHOT_URL=https://192.168.0.3/cgi-bin/snapshot.cgi?channel=2
CAMERA_USER=admin
CAMERA_PASSWORD=Mall@2024
USE_ISAPI_SNAPSHOT=false

# ALPR OCR & Detection Tuning
MIN_CONFIDENCE=0.70
DEBOUNCE_SECONDS=15
VOTING_COUNT=2
FRAME_SKIP=3
HEARTBEAT_SECONDS=30

# Region of Interest (ROI) normalized coordinates [y_min, y_max, x_min, x_max] (0.0 to 1.0)
# Crops image to the car approach lane, cutting out sky and ceiling
ENTRANCE_ROI=0.40,0.90,0.15,0.85
EXIT_ROI=0.40,0.90,0.15,0.85

# Storage & Logging
SNAPSHOT_DIR=../storage/snapshots
LOG_FILE=../storage/logs/alpr.log
