# Mombasa Mall Basement Parking - ALPR Python Worker Environment
# Edge PC Configuration (NIC 1: 192.168.0.50, NIC 2: 192.168.1.50)

# Local PHP API Gateway
API_URL=http://127.0.0.1/parking/api/gate/plate-detected.php
HEALTH_URL=http://127.0.0.1/parking/api/health.php
API_KEY=MOMBASA_PARKING_ALPR_SECRET_KEY_2026

# CCTV NVR Streams (192.168.1.1 on isolated NIC 2)
# Prefer RTSP TCP on port 554
ENTRANCE_RTSP=rtsp://admin:password@192.168.1.1:554/Streaming/Channels/101
EXIT_RTSP=rtsp://admin:password@192.168.1.1:554/Streaming/Channels/201

# Fallback ISAPI JPEG Snapshot endpoints
ENTRANCE_SNAPSHOT_URL=http://192.168.1.1/ISAPI/Streaming/channels/101/picture
EXIT_SNAPSHOT_URL=http://192.168.1.1/ISAPI/Streaming/channels/201/picture
USE_ISAPI_SNAPSHOT=false

# ALPR OCR & Detection Tuning
MIN_CONFIDENCE=0.70
DEBOUNCE_SECONDS=15
VOTING_COUNT=2
FRAME_SKIP=3
HEARTBEAT_SECONDS=30

# Region of Interest (ROI) normalized coordinates [y_min, y_max, x_min, x_max] (0.0 to 1.0)
# Crops image to the car approach lane, cutting out sky and ceiling
ENTRANCE_ROI=0.40,0.90,0.15,0.85
EXIT_ROI=0.40,0.90,0.15,0.85

# Storage & Logging
SNAPSHOT_DIR=../storage/snapshots
LOG_FILE=../storage/logs/alpr.log
